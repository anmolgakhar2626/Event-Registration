            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "02 - Organiser Workflow (Events Management)",
      "description": "Endpoints accessible by Organisers to create, publish, and manage events.",
      "item": [
        {
          "name": "2.1 Create Event (Draft)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    var data = pm.response.json();",
                  "    pm.collectionVariables.set('eventId', data.id);",
                  "    console.log('Saved Event ID: ' + data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{organiserToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Cloud Native Summit 2026\",\n  \"description\": \"Deep dive into Microservices, Kubernetes & Event-Driven Systems\",\n  \"venue\": \"Tech Park Convention Hall\",\n  \"eventDate\": \"2026-11-20T10:00:00\",\n  \"maxCapacity\": 50,\n  \"waitlistCap\": 10,\n  \"price\": 499.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events"]
            }
          }
        },
        {
          "name": "2.2 Publish Event (Go Live)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{organiserToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/events/{{eventId}}/publish",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "{{eventId}}", "publish"]
            }
          }
        },
        {
          "name": "2.3 Get My Organised Events",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{organiserToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/events/mine",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "mine"]
            }
          }
        },
        {
          "name": "2.4 Cancel Event (Notify Attendees)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{organiserToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/events/{{eventId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "{{eventId}}", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "03 - Public Discovery",
      "description": "Publicly accessible endpoints (no auth required) to browse events.",
      "item": [
        {
          "name": "3.1 List All Published Events",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "3.2 Get Event Details by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events/{{eventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "{{eventId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "04 - Attendee Workflow (Registrations & Tickets)",
      "description": "Booking, waitlisting, viewing tickets, and cancellations.",
      "item": [
        {
          "name": "4.1 Register for Event (Individual)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    var data = pm.response.json();",
                  "    pm.collectionVariables.set('ticketToken', data.ticketToken);",
                  "    pm.collectionVariables.set('registrationId', data.id);",
                  "    console.log('Saved Ticket Token: ' + data.ticketToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{attendeeToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/registrations/{{eventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "registrations", "{{eventId}}"]
            }
          }
        },
        {
          "name": "4.2 Register as Team",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{attendeeToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teamName\": \"ByteSquad\",\n  \"memberEmails\": [\"bob@test.com\", \"charlie@test.com\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/registrations/{{eventId}}/team",
              "host": ["{{baseUrl}}"],
              "path": ["api", "registrations", "{{eventId}}", "team"]
            }
          }
        },
        {
          "name": "4.3 View My Registrations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{attendeeToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/registrations/my",
              "host": ["{{baseUrl}}"],
              "path": ["api", "registrations", "my"]
            }
          }
        },
        {
          "name": "4.4 Get Ticket & QR Info",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{attendeeToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{ticketToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{ticketToken}}"]
            }
          }
        },
        {
          "name": "4.5 Cancel Registration (Triggers Waitlist Promotion)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{attendeeToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/registrations/{{registrationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "registrations", "{{registrationId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "05 - Event Gate Check-In (Idempotent Scanning)",
      "description": "Organiser QR scanning at event gate. Tested for double-scan idempotency.",
      "item": [
        {
          "name": "5.1 First Scan Ticket (Successful Entry)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{organiserToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/check-in?token={{ticketToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "check-in"],
              "query": [
                {
                  "key": "token",
                  "value": "{{ticketToken}}"
                }
              ]
            }
          }
        },
        {
          "name": "5.2 Duplicate Scan (Idempotent - alreadyUsed=true)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{organiserToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/check-in?token={{ticketToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "check-in"],
              "query": [
                {
                  "key": "token",
                  "value": "{{ticketToken}}"
                }
              ]
            }
          }
        }
      ]
    },
