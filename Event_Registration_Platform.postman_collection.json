              "path": ["api", "admin", "events"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "6.2 Real-Time Event Statistics & Revenue",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/events/{{eventId}}/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "events", "{{eventId}}", "stats"]
            }
          }
        },
        {
          "name": "6.3 Admin Force-Cancel Event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/events/{{eventId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "events", "{{eventId}}", "cancel"]
            }
          }
        }
      ]
    }
  ]
